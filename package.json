{
  "name": "vault-graph",
  "version": "0.6.128",
  "private": true,
  "description": "Obsidian plugin that maps a vault: topic clusters, bridge notes, gaps, views and lenses.",
  "scripts": {
    "build": "node build.js",
    "page": "node build.js page",
    "test": "node tests/run.js",
    "test:vault": "node tests/run.js --vault",
    "deploy": "node scripts/deploy.js",
    "audit:views": "node tests/audit_views.js",
    "audit:repeats": "node tests/audit_repeats.js",
    "audit:nodes": "node tests/audit_nodes.js --per 3 --gate",
    "audit:nodes:vault": "node tests/audit_nodes.js --vault --per 3 --gate --out .out/node-audit-real.md",
    "release": "node scripts/release.js",
    "sample": "node fixtures/make_sample.js",
    "install-release": "node scripts/install_release.js",
    "sync": "node scripts/sync.js",
    "queue": "node scripts/queue.js",
    "look": "node scripts/look.js",
    "ship": "node scripts/ship.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "vault-graph-views": "github:JacksonKupris/vault-graph-views#v0.12.2"
  }
}
